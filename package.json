{
  "name": "pico-os-presentation",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "dev:selectable-text": "slidev --open --base /selectable-text/",
    "build": "slidev build",
    "export": "slidev export",
    "short:apply": "node scripts/apply-short-version.mjs",
    "short:sync": "node scripts/sync-short-version-selection.mjs",
    "test:short": "node scripts/test-short-version.mjs",
    "rebuild:readme": "node scripts/rebuild-from-readme.mjs",
    "source:compare": "node scripts/source-state.mjs compare",
    "source:save": "node scripts/source-state.mjs save",
    "test:source-state": "node scripts/test-source-state.mjs",
    "test:source": "node scripts/check-readme-coverage.mjs",
    "test:rebuild": "node scripts/test-rebuild-protection.mjs",
    "test:overviews": "node scripts/test-section-overviews.mjs",
    "test:navigation": "node scripts/test-presentation-navigation.mjs",
    "test:notes": "node scripts/test-slide-identities.mjs && node scripts/test-slide-notes.mjs",
    "test:notes:browser": "node scripts/test-slide-notes-browser.mjs"
  },
  "devDependencies": {
    "@slidev/cli": "52.18.0",
    "@slidev/parser": "52.18.0",
    "@slidev/theme-default": "0.25.0",
    "asciinema-player": "3.15.1",
    "markdown-it": "^14.3.0",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "1.62.0"
  }
}
