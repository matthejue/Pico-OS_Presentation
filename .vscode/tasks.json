{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate presentation PDF",
      "type": "shell",
      "command": "make generate-presentation-pdf",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build static presentation",
      "type": "shell",
      "command": "make build-static-presentation",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Generate short presentation PDF",
      "type": "shell",
      "command": "make generate-short-presentation-pdf",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build short static presentation",
      "type": "shell",
      "command": "make build-short-static-presentation",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Launch presentation in browser",
      "type": "shell",
      "command": "make launch-presentation-in-browser",
      "isBackground": true,
      "problemMatcher": {
        "owner": "slidev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "^$"
        }
      }
    },
    {
      "label": "Launch presentation in browser (selectable text)",
      "type": "shell",
      "command": "make launch-presentation-with-selectable-text",
      "isBackground": true,
      "problemMatcher": {
        "owner": "slidev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "^$"
        }
      }
    },
    {
      "label": "Launch short presentation in browser",
      "type": "shell",
      "command": "make launch-short-presentation-in-browser",
      "isBackground": true,
      "problemMatcher": {
        "owner": "slidev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "^$"
        }
      }
    },
    {
      "label": "Launch short presentation in browser (selectable text)",
      "type": "shell",
      "command": "make launch-short-presentation-with-selectable-text",
      "isBackground": true,
      "problemMatcher": {
        "owner": "slidev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "^$"
        }
      }
    }
  ]
}
